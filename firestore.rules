
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function logueado() {
      return request.auth != null;
    }

    function perfilExiste() {
      return logueado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function perfilActual() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function admin() {
      return perfilExiste() && perfilActual().rol == 'admin';
    }

    function cuentaActiva() {
      return perfilExiste()
        && (!('estado' in perfilActual())
        || perfilActual().estado != 'suspendido');
    }

    // USUARIOS
    match /usuarios/{uid} {
      allow read: if logueado()
        && (request.auth.uid == uid || admin());

      allow create: if logueado()
        && request.auth.uid == uid
        && request.resource.data.rol == 'usuario'
        && request.resource.data.estado == 'activo'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'nombreUsuario', 'fotoPerfil', 'biografia',
          'rol', 'estado', 'fechaRegistro'
        ]);

      allow update: if admin() || (
        cuentaActiva()
        && request.auth.uid == uid
        && request.resource.data.rol == resource.data.rol
        && (!('estado' in resource.data) || request.resource.data.estado == resource.data.estado)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['nombreUsuario', 'fotoPerfil', 'biografia'])
      );

      allow delete: if admin();
    }

    // DATOS MUSICALES PERSONALES
    match /usuarios/{uid}/{subcoleccion}/{documentoId} {
      allow read, create, update, delete: if cuentaActiva()
        && request.auth.uid == uid
        && subcoleccion in ['favoritos', 'seguidos', 'playlists'];
    }

    // PUBLICACIONES Y COMENTARIOS
    match /publicaciones/{id} {
      allow read: if cuentaActiva();

      allow create: if cuentaActiva()
        && request.resource.data.autorId == request.auth.uid
        && request.resource.data.autorNombre == perfilActual().nombreUsuario
        && request.resource.data.contenido is string
        && request.resource.data.contenido.size() > 0
        && request.resource.data.contenido.size() <= 5000
        && request.resource.data.categoria is string
        && request.resource.data.keys().hasOnly([
          'autorId', 'autorNombre', 'autorFoto', 'categoria', 'contenido',
          'imagen', 'comentarios', 'likes', 'editado',
          'fechaCreacion', 'fechaActualizacion'
        ]);

      allow update: if cuentaActiva()
        && resource.data.autorId == request.auth.uid
        && request.resource.data.autorId == resource.data.autorId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['contenido', 'categoria', 'imagen', 'editado', 'fechaActualizacion'])
        && request.resource.data.contenido is string
        && request.resource.data.contenido.size() > 0
        && request.resource.data.contenido.size() <= 5000;

      allow delete: if cuentaActiva()
        && (admin() || resource.data.autorId == request.auth.uid);
    }

    // DENUNCIAS
    match /denuncias/{id} {
      allow create: if cuentaActiva()
        && request.resource.data.denuncianteId == request.auth.uid
        && request.resource.data.motivo is string
        && request.resource.data.publicacionId is string;

      allow read, update, delete: if admin();
    }

    // VERSIONES
    match /versiones/{id} {
      allow read: if cuentaActiva();
      allow create, update, delete: if admin();
    }
        // RANKING MUSICAL
    match /rankingMusical/{songId} {
      allow read: if cuentaActiva();

      allow create: if cuentaActiva()
        && request.resource.data.keys().hasOnly([
          'songId', 'reproducciones', 'updatedAt'
        ])
        && request.resource.data.songId is int
        && request.resource.data.songId > 0
        && request.resource.data.reproducciones == 1
        && request.resource.data.updatedAt == request.time;

      allow update: if cuentaActiva()
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['reproducciones', 'updatedAt'])
        && request.resource.data.songId == resource.data.songId
        && request.resource.data.reproducciones
          == resource.data.reproducciones + 1
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // PRODUCTOS, BANNERS Y MÚSICA
    match /{coleccion}/{id} {
      allow read: if cuentaActiva()
        && coleccion in [
          'productos', 'banners', 'canciones', 'albumes',
          'compositores', 'playlists'
        ];

      allow write: if admin()
        && coleccion in [
          'productos', 'banners', 'canciones', 'albumes',
          'compositores', 'playlists'
        ];
    }
  }
}
